# Copy to .env.local (eve dev loads it automatically). Set ONE model credential:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# HACKDESK_MODEL=anthropic/claude-sonnet-5   # gateway model id when using AI_GATEWAY_API_KEY

# Optional
# GITHUB_TOKEN=            # higher GitHub API rate limits for audits
# HACKDESK_WEBHOOK_URL=    # Slack/Discord incoming webhook for the daily brief + change alerts
# HACKDESK_BOARD_TOKEN=    # required to open the board / calendar feed from anywhere but localhost
# HACKDESK_DATA_DIR=       # where db.json lives (default ./.hackdesk)
